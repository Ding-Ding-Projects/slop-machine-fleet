            ],
            "url": {
              "raw": "{{baseUrl}}/api/workers/{{workerId}}/auth/{{authProvider}}/input",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "workers",
                "{{workerId}}",
                "auth",
                "{{authProvider}}",
                "input"
              ]
            },
            "description": "Use only the current worker response identities in local unsynchronized variables. Do not save response bodies or export populated environments. Legacy worker capability is update-required; no raw input fallback.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sessionId\": \"{{workerAuthSessionId}}\",\n  \"promptId\": \"{{workerAuthPromptId}}\",\n  \"action\": \"enter\"\n}",
              "options": {
